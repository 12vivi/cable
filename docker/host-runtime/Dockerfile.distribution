ARG CABLE_BASE_IMAGE=archlinux@sha256:345a872f6c95e082d4b8c050af637eebb57402c6e2177b411c3acf7df84eb33b
FROM ${CABLE_BASE_IMAGE}

ARG CABLE_BASE_IMAGE
ARG CABLE_RUNTIME_UID=1000
ARG CABLE_RUNTIME_GID=1000
ARG CABLE_ARCH_SNAPSHOT=2026/08/09

ENV HOME=/home/huashen \
    PATH=/opt/venv/bin:/home/huashen/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CABLE_DISTRIBUTION=/opt/cable/distribution \
    PLAYWRIGHT_BROWSERS_PATH=/opt/cable/browsers

RUN printf '%s\n' \
        'CacheServer = https://mirrors.tuna.tsinghua.edu.cn/archlinux/$repo/os/$arch' \
        'CacheServer = https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch' \
        "Server = https://archive.archlinux.org/repos/${CABLE_ARCH_SNAPSHOT}/\$repo/os/\$arch" \
        > /etc/pacman.d/mirrorlist \
    && pacman -Syyu --noconfirm \
    && pacman -S --noconfirm --needed \
        ca-certificates \
        alsa-lib \
        at-spi2-core \
        cairo \
        libcups \
        libdrm \
        libxcomposite \
        libxdamage \
        libxfixes \
        libxkbcommon \
        libxrandr \
        mesa \
        nss \
        pango \
        ttf-liberation \
        wqy-zenhei \
        curl \
        git \
        nodejs \
        python \
        python-pip \
        util-linux \
        zsh \
    && pacman -Scc --noconfirm \
    && groupadd --gid "${CABLE_RUNTIME_GID}" huashen \
    && useradd \
        --uid "${CABLE_RUNTIME_UID}" \
        --gid "${CABLE_RUNTIME_GID}" \
        --create-home \
        --shell /usr/bin/zsh \
        huashen

WORKDIR /opt/cable

COPY requirements.lock /opt/cable/distribution/requirements.lock
# 镜像不带浏览器：用到 Chromium 的插件（visuals、design）在 resources.json 里声明并在安装时取回。
# 开头 ENV 里的 PLAYWRIGHT_BROWSERS_PATH 保持不动：开头一变，系统包层缓存全部失效，要从 Arch 归档重下。
ARG CABLE_PYPI_INDEX_URL=https://pypi.org/simple
ARG CABLE_REQUIREMENTS_SHA256
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip \
    && printf '%s  %s\n' "${CABLE_REQUIREMENTS_SHA256}" /opt/cable/distribution/requirements.lock | sha256sum -c - \
    && python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install \
        --index-url "${CABLE_PYPI_INDEX_URL}" \
        --require-hashes \
        -r /opt/cable/distribution/requirements.lock \
    && /opt/venv/bin/python -c "import site; from pathlib import Path; Path(site.getsitepackages()[0], 'cable-sdk.pth').write_text('/opt/cable/source/sdk/python/src\\n')"

# 源码变化不应使前面的依赖层失效。
ARG CABLE_SOURCE_COMMIT
ARG CABLE_SOURCE_TREE
ARG CABLE_CORE_SHA256

# The only source material copied into this image is the generated Core tar.
COPY core.tar /opt/cable/distribution/core.tar
COPY distribution.json /opt/cable/distribution/distribution.json
COPY bundles /opt/cable/distribution/bundles
COPY sources /opt/cable/distribution/sources
COPY *.bundle /opt/cable/distribution/
COPY Dockerfile.distribution /opt/cable/distribution/Dockerfile.distribution
COPY distribution-entrypoint.sh /opt/cable/distribution/distribution-entrypoint.sh
COPY distribution-entrypoint.sh /opt/cable/distribution-entrypoint.sh

# 运行期禁止写字节码且镜像只读：构建时预编译核心源码，每次启动不再重新编译。
RUN test -n "${CABLE_SOURCE_COMMIT}" \
    && test -n "${CABLE_SOURCE_TREE}" \
    && test -n "${CABLE_CORE_SHA256}" \
    && test "$(sha256sum /opt/cable/distribution/core.tar | cut -d' ' -f1)" = "${CABLE_CORE_SHA256}" \
    && mkdir -p /opt/cable/source \
    && tar -xf /opt/cable/distribution/core.tar -C /opt/cable/source \
    && test ! -e /opt/cable/source/plugins \
    && test -f /opt/cable/source/config.example.toml \
    && /opt/venv/bin/python -m compileall -q -j 0 /opt/cable/source \
    && /opt/venv/bin/python -c "from pathlib import Path; assert Path('/opt/cable/distribution/requirements.lock').read_bytes() == Path('/opt/cable/source/docker/host-runtime/requirements.lock').read_bytes(), 'Build lock differs from Core lock'" \
    && /opt/venv/bin/python -c "import cable_sdk; assert cable_sdk.__file__.startswith('/opt/cable/source/sdk/python/src/')" \
    && node --version

RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip \
    && mkdir -p /tmp/cable-distribution-workspace /tmp/cable-distribution-plugins \
    && /opt/venv/bin/python /opt/cable/source/scripts/distribution_runtime.py prepare-wheels \
        --distribution /opt/cable/distribution \
    && /opt/venv/bin/python /opt/cable/source/scripts/install_plugin_distribution.py \
        --distribution /opt/cable/distribution \
        --bundle /opt/cable/distribution/bundles/base.toml \
        --workspace /tmp/cable-distribution-workspace \
        --plugins-home /tmp/cable-distribution-plugins \
        --verify-only \
    && /opt/venv/bin/python /opt/cable/source/scripts/distribution_runtime.py write \
        --distribution /opt/cable/distribution \
        --output /opt/cable/runtime-info.json \
        --source-commit "${CABLE_SOURCE_COMMIT}" \
        --source-tree "${CABLE_SOURCE_TREE}" \
        --core-sha256 "${CABLE_CORE_SHA256}" \
        --base-image "${CABLE_BASE_IMAGE}" \
        --arch-snapshot "${CABLE_ARCH_SNAPSHOT}" \
        --pypi-index-url "${CABLE_PYPI_INDEX_URL}" \
    && rm -rf /tmp/cable-distribution-workspace /tmp/cable-distribution-plugins \
    && chown -R root:root /opt/cable \
    && chmod -R a=rX /opt/cable \
    && chmod 0555 /opt/cable/distribution-entrypoint.sh

LABEL org.opencontainers.image.revision="${CABLE_SOURCE_COMMIT}"

USER huashen:huashen
ENV CABLE_PLUGIN_DISTRIBUTION=/opt/cable/distribution
ENTRYPOINT ["/opt/cable/distribution-entrypoint.sh"]
CMD ["gateway"]
