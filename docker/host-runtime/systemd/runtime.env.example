# This file is copied to ~/.config/cable-container/runtime.env with mode 0600.
# Every path and digest belongs to one approved release generation.
CABLE_BRIDGE_PYTHON=/srv/data/services/cable/bridge-venvs/COMMIT/bin/python
CABLE_HOST_PYTHON_PREFIX=/home/huashen/.local/share/mise/installs/python/3.14.6
CABLE_MISE=/home/huashen/.local/bin/mise
CABLE_RUNTIME_CHECKOUT=/srv/data/services/cable/runtime-sources/COMMIT
CABLE_RUNTIME_COMMIT=FULL_40_CHARACTER_COMMIT
CABLE_RUNTIME_TREE=FULL_40_CHARACTER_TREE
CABLE_HOST_TOOLCHAIN_DIGEST=FULL_64_CHARACTER_SHA256
CABLE_RELEASE_MANIFEST=/srv/data/services/cable/releases/COMMIT.json
CABLE_IMAGE=sha256:FULL_64_CHARACTER_IMAGE_ID
CABLE_HOST_BRIDGE_SOCKET=/srv/data/services/cable/run/host-bridge.sock
CABLE_HOST_BRIDGE_TOKEN_FILE=/srv/data/services/cable/secrets/host-bridge.token
CABLE_HOST_BRIDGE_TOKEN=REDACTED_BOOT_CAPABILITY
CABLE_HOST_BRIDGE_DIR=/srv/data/services/cable/run
CABLE_HOST_ARTIFACT_ROOT=/srv/data/services/cable/runtime/host-executions
CABLE_CONFIG=/srv/data/services/cable/state/config.toml
CABLE_WORKSPACE=/srv/data/services/cable/state/workspace
CABLE_PLUGIN_HOME=/srv/data/services/cable/state/plugin-home
CABLE_EXPERIMENT_ROOT=/srv/data/services/cable/state
CABLE_WORKLOAD_RUNTIME_DIR=/srv/data/services/cable/state/workload-runtime
CABLE_CONTAINER_NAME=cable-core
CABLE_WEB_BIND_ADDRESS=127.0.0.1
CABLE_PUBLISHED_WEB_PORT=2236
CABLE_SERVICES_NETWORK=cable-services
CABLE_WORKLOAD_NETWORK=cable-workloads
CABLE_UID=1000
CABLE_GID=1000
CABLE_DOCKER_GID=961
CABLE_ENVIRONMENT=hua-home
CABLE_LOG_LEVEL=INFO
TZ=Asia/Shanghai
OPENCODE_GO_API_KEY=REDACTED_RUNTIME_SECRET
